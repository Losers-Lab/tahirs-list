{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "shortcut": {
      "type": "remote",
      "url": "https://mcp.shortcut.com/mcp",
      "enabled": true
    },
    "kotlin-lib-mcp": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "kotlin-lib-mcp-cache:/home/mcp/.cache",
        "ghcr.io/aoreshkov/kotlin-lib-mcp"
      ],
      "enabled": true
    },
    "svelte": {
      "type": "remote",
      "url": "https://mcp.svelte.dev/mcp",
      "enabled": true
    },
    "shadcn-svelte": {
      "type": "local",
      "command": ["npx", "-y", "shadcn-svelte-mcp"],
      "enabled": true
    }
  }
}
